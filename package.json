{
  "name": "agent-skills-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --parallel --filter ./packages/** build",
    "check": "rs check && pnpm run check-spell",
    "check-spell": "cspell",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks && pnpm build"
  },
  "devDependencies": {
    "@rstackjs/config": "workspace:*",
    "@types/node": "^24.10.9",
    "cspell": "^9.6.4",
    "cspell-ban-words": "^0.0.4",
    "heading-case": "^2.0.2",
    "rstack": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "pnpm": ">=12.23.0"
  }
}
