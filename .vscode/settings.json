{
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/.git": true,
    "**/dist": true,
    "**/dist-*": true,
    "**/doc_build": true,
    "**/node_modules": true,
    "**/tsconfig.tsbuildinfo": true
